# Copy to a private environment file or your runtime secret store.
# Use the same actual HTTPS origin at build time and runtime.
NEXT_PUBLIC_WEBAPP_URL=https://booking.example.com
NEXT_PUBLIC_WEBSITE_URL=https://booking.example.com
NEXTAUTH_URL=https://booking.example.com
CAL_MCP_BASE_URL=https://booking.example.com
CAL_MCP_ALLOWED_ORIGINS=

CAL_PRIVATE_INSTANCE=true
NEXT_PUBLIC_DISABLE_SIGNUP=true
ORGANIZATIONS_ENABLED=false
NEXT_PUBLIC_ORG_SELF_SERVE_ENABLED=false
GOOGLE_LOGIN_ENABLED=false
CALCOM_TELEMETRY_DISABLED=1

# Generate separate persistent secrets. Never commit the filled file.
NEXTAUTH_SECRET=
# Exactly 32 ASCII bytes for the existing AES-256 credential encryption.
CALENDSO_ENCRYPTION_KEY=

# PostgreSQL URLs from the dedicated Supabase project's Connect panel.
# Require TLS. Use the direct or session-pooler URL for migrations.
DATABASE_URL=
DATABASE_DIRECT_URL=

# Downloaded Google OAuth web-client JSON, on one line.
# The calendar callback is /api/integrations/googlecalendar/callback.
GOOGLE_API_CREDENTIALS=

# A Resend sending key and a sender on your verified domain.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME="Between Calls"

# Optional public information pages. Review the copy before enabling.
CAL_PUBLIC_INFORMATION_ENABLED=false
CAL_PUBLIC_CONTACT_EMAIL=

# Keep custom workflows, SMS and asynchronous task services out of v1.
ENABLE_ASYNC_TASKER=false
