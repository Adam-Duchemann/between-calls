{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && node .yarn/releases/yarn-4.12.0.cjs build:cal",
  "installCommand": "cd ../.. && node .yarn/releases/yarn-4.12.0.cjs install --immutable",
  "regions": ["dub1"],
  "crons": [
    {
      "path": "/api/cron/calendar-subscriptions",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/calendar-subscriptions-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/queuedFormResponseCleanup",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/tasks/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/tasks/cleanup",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/credentials",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/selected-calendars",
      "schedule": "*/5 * * * *"
    }
  ]
}
